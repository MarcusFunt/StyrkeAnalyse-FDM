{
  "name": "StyrkeAnalyse-FDM",
  "dockerComposeFile": "../compose.yaml",
  "service": "fenicsx",
  "runServices": ["fenicsx"],
  "workspaceFolder": "/workspaces/styrkeanalyse-fdm",
  "remoteUser": "fdm",
  "overrideCommand": false,
  "postCreateCommand": "uv sync --frozen --all-groups && uv pip install --python /opt/venv/bin/python --requirement docker/jupyter-requirements.txt && scripts/verify-environment.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "editor.formatOnSave": true
      }
    }
  }
}
